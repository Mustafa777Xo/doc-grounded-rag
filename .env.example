# Required: absolute or relative path to directory containing PDF files
DOCS_DIR=

# Runtime profile: dev | test
PROFILE=

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Local retrieval models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
EMBEDDING_MODEL_REVISION=c9745ed1d9f207416be6d2e6f8de32d1f16199bf

# Retrieval candidate budgets and Reciprocal Rank Fusion
DENSE_TOP_K=20
KEYWORD_TOP_K=20
FUSION_RRF_K=60
RERANK_CANDIDATE_COUNT=20
FINAL_RESULT_COUNT=5
RERANKER_BATCH_SIZE=16

# Logging
LOG_LEVEL=INFO